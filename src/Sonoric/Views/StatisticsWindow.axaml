<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sonoric.ViewModels"
        x:Class="Sonoric.Views.StatisticsWindow"
        x:DataType="vm:StatisticsViewModel"
        Title="Статистика"
        Icon="/Assets/sonoric.png"
        Width="420"
        Height="280"
        MinWidth="360"
        MinHeight="240"
        Background="#000000"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <DockPanel Margin="20">
        <Button DockPanel.Dock="Bottom"
                Classes="app-button"
                Content="Закрыть"
                HorizontalAlignment="Right"
                Click="OnClose"/>
        <StackPanel Spacing="16">
            <TextBlock Text="Статистика" FontSize="20" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                <TextBlock Text="Песни" Foreground="#8A8A8A"/>
                <TextBlock Grid.Column="1" Text="{Binding SongCountText}"/>
                <TextBlock Grid.Row="1" Text="Вес библиотеки" Foreground="#8A8A8A"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LibrarySizeText}"/>
                <TextBlock Grid.Row="2" Text="Альбомы" Foreground="#8A8A8A"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AlbumCountText}"/>
                <TextBlock Grid.Row="3" Text="Плейлисты" Foreground="#8A8A8A"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PlaylistCountText}"/>
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>

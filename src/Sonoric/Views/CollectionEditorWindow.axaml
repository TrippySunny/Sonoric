<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sonoric.ViewModels"
        x:Class="Sonoric.Views.CollectionEditorWindow"
        x:DataType="vm:CollectionEditorViewModel"
        Title="{Binding Header}"
        Icon="/Assets/sonoric.png"
        Width="760"
        Height="720"
        MinWidth="640"
        MinHeight="560"
        Background="#000000"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <DockPanel Margin="20">
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
            <TextBlock Text="{Binding ValidationMessage}"
                       Foreground="#C8C8C8"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Classes="app-button"
                    Content="Отмена"
                    Click="OnCancel"
                    Margin="0,0,10,0"/>
            <Button Grid.Column="2"
                    Classes="app-button"
                    Content="Сохранить"
                    Click="OnSave"/>
        </Grid>

        <DockPanel>
            <ScrollViewer DockPanel.Dock="Top"
                          MaxHeight="360"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding Header}" FontSize="20" FontWeight="SemiBold"/>

                    <TextBlock Text="Название" Foreground="#8A8A8A"/>
                    <TextBox Text="{Binding TitleText}" Watermark="Название набора"/>

                    <StackPanel Spacing="14" IsVisible="{Binding ShowAlbumFields}">
                        <TextBlock Text="Автор" Foreground="#8A8A8A"/>
                        <TextBox Text="{Binding Author}" Watermark="Автор"/>
                        <TextBlock Text="Год" Foreground="#8A8A8A"/>
                        <TextBox Text="{Binding YearText}" Watermark="Год"/>
                    </StackPanel>

                    <TextBlock Text="Описание" Foreground="#8A8A8A"/>
                    <TextBox Text="{Binding Description}"
                             Watermark="Описание"
                             AcceptsReturn="True"
                             Height="80"
                             TextWrapping="Wrap"/>

                    <TextBlock Text="Тип" Foreground="#8A8A8A"/>
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <RadioButton Content="Альбом"
                                     GroupName="Kind"
                                     IsChecked="{Binding IsAlbum}"/>
                        <RadioButton Content="Плейлист"
                                     GroupName="Kind"
                                     IsChecked="{Binding IsPlaylist}"/>
                    </StackPanel>

                    <TextBlock Text="Обложка" Foreground="#8A8A8A"/>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="96"
                                Height="96"
                                Background="#111111"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                ClipToBounds="True">
                            <Panel>
                                <TextBlock Text="♪"
                                           FontSize="28"
                                           Foreground="#3A3A3A"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding !HasCoverPreview}"/>
                                <Image Source="{Binding CoverPreview}"
                                       Stretch="UniformToFill"
                                       IsVisible="{Binding HasCoverPreview}"/>
                            </Panel>
                        </Border>
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <Button Classes="app-button" Content="Выбрать фото" Command="{Binding PickCoverCommand}"/>
                            <Button Classes="app-button" Content="Убрать фото" Command="{Binding RemoveCoverCommand}"/>
                            <TextBlock Text="Если фото нет, берётся обложка первого трека"
                                       Foreground="#6A6A6A"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Width="280"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <DockPanel Margin="0,16,0,0">
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right"
                            Classes="app-button"
                            Content="Импортировать"
                            Command="{Binding ImportFilesCommand}"/>
                    <TextBlock Text="Треки"
                               Foreground="#8A8A8A"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox DockPanel.Dock="Top"
                         Text="{Binding TrackSearchQuery}"
                         Watermark="Поиск песни"
                         Margin="0,8,0,0"/>
                <WrapPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                    <Button Classes="tab-chip"
                            Classes.selected="{Binding IsLibraryTab}"
                            Content="Все песни"
                            Command="{Binding ShowLibraryTabCommand}"/>
                    <Button Classes="tab-chip"
                            Classes.selected="{Binding IsSelectedTab}"
                            Content="{Binding SelectedTabLabel}"
                            Command="{Binding ShowSelectedTabCommand}"/>
                </WrapPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Порядок задаётся стрелками"
                           FontSize="12"
                           Foreground="#6A6A6A"
                           Margin="0,8,0,0"
                           IsVisible="{Binding IsSelectedTab}"/>
                <Panel>
                    <ListBox ItemsSource="{Binding LibraryChoices}"
                             Classes="compact"
                             IsVisible="{Binding IsLibraryTab}"
                             ScrollViewer.AllowAutoHide="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrackChoice">
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          Margin="8,6,20,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#8A8A8A"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox ItemsSource="{Binding SelectedChoices}"
                             Classes="compact"
                             IsVisible="{Binding IsSelectedTab}"
                             ScrollViewer.AllowAutoHide="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrackChoice">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,2,16,2">
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              Margin="8,6,8,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#8A8A8A"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <Button Grid.Column="1"
                                            Classes="order-button"
                                            Command="{Binding MoveUpCommand}"
                                            IsEnabled="{Binding CanMoveUp}">
                                        <Viewbox Width="10" Height="10">
                                            <Path Fill="#C8C8C8" Data="M 8,2 L 14,12 L 2,12 Z"/>
                                        </Viewbox>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Classes="order-button"
                                            Command="{Binding MoveDownCommand}"
                                            IsEnabled="{Binding CanMoveDown}">
                                        <Viewbox Width="10" Height="10">
                                            <Path Fill="#C8C8C8" Data="M 2,4 L 14,4 L 8,14 Z"/>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding EmptyTracksText}"
                               IsVisible="{Binding IsTracksEmpty}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#6A6A6A"/>
                </Panel>
            </DockPanel>
        </DockPanel>
    </DockPanel>
</Window>

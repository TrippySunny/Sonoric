<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
    </Style>

    <Style Selector="Button.app-button">
        <Setter Property="Background" Value="{DynamicResource AppButtonBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#C8C8C8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.app-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppButtonHoverBrush}"/>
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.app-button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#000000"/>
    </Style>
    <Style Selector="Button.app-button:disabled /template/ ContentPresenter">
        <Setter Property="Foreground" Value="#666666"/>
        <Setter Property="BorderBrush" Value="#3A3A3A"/>
        <Setter Property="Background" Value="#101010"/>
    </Style>

    <Style Selector="Button.icon-button">
        <Setter Property="Background" Value="#141414"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#C8C8C8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="56"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tab-chip">
        <Setter Property="Background" Value="#141414"/>
        <Setter Property="Foreground" Value="#8A8A8A"/>
        <Setter Property="BorderBrush" Value="#2A2A2A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>
    <Style Selector="Button.tab-chip:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1A1A1A"/>
        <Setter Property="BorderBrush" Value="#C8C8C8"/>
    </Style>
    <Style Selector="Button.tab-chip.selected">
        <Setter Property="Background" Value="#141414"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.tab-chip.selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#141414"/>
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.mood-chip">
        <Setter Property="Background" Value="#111111"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="Button.mood-chip:pointerover /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.88"/>
    </Style>

    <Style Selector="Button.order-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.order-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1A1A1A"/>
    </Style>
    <Style Selector="Button.order-button:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.25"/>
    </Style>
    <Style Selector="Button.favorite-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.favorite-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1A1A1A"/>
    </Style>
    <Style Selector="Button.track-play-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.track-play-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1A1A1A"/>
    </Style>

    <Style Selector="Button.cover-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.cover-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#22000000"/>
    </Style>
    <Style Selector="Button.album-tile">
        <Setter Property="Background" Value="#111111"/>
        <Setter Property="Foreground" Value="#F2F2F2"/>
        <Setter Property="BorderBrush" Value="#2A2A2A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTip.ShowDelay" Value="2000"/>
        <Setter Property="ToolTip.Placement" Value="Pointer"/>
    </Style>
    <Style Selector="Button.album-tile:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1A1A1A"/>
        <Setter Property="BorderBrush" Value="#C8C8C8"/>
    </Style>

    <Style Selector="Button.playlist-row">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#F2F2F2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.playlist-row:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#161616"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="#111111"/>
        <Setter Property="Foreground" Value="#F2F2F2"/>
        <Setter Property="BorderBrush" Value="#2A2A2A"/>
        <Setter Property="CaretBrush" Value="#FFFFFF"/>
        <Setter Property="SelectionBrush" Value="#3A3A3A"/>
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="#F2F2F2"/>
    </Style>
    <Style Selector="RadioButton">
        <Setter Property="Foreground" Value="#F2F2F2"/>
    </Style>
    <Style Selector="ListBox.compact ListBoxItem">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="Button.play-button">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="48"/>
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.skip-button">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.skip-button /template/ ContentPresenter">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="CornerRadius" Value="20"/>
    </Style>
    <Style Selector="Button.skip-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#D8D8D8"/>
    </Style>
    <Style Selector="Button.menu-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.menu-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1A1A1A"/>
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="#0A0A0A"/>
        <Setter Property="Foreground" Value="#F2F2F2"/>
        <Setter Property="BorderBrush" Value="#2A2A2A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="#111111"/>
        <Setter Property="Foreground" Value="#F2F2F2"/>
        <Setter Property="BorderBrush" Value="#2A2A2A"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="ComboBox.section-combo">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="Button.brand-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.brand-button /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.brand-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.brand-button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="#F2F2F2"/>
    </Style>
    <Style Selector="Button.play-button /template/ ContentPresenter">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="24"/>
    </Style>
    <Style Selector="Button.play-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#D8D8D8"/>
        <Setter Property="BorderBrush" Value="#D8D8D8"/>
    </Style>
    <Style Selector="Button.play-button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#B8B8B8"/>
    </Style>
    <Style Selector="Button.play-button:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="#8A8A8A"/>
        <Setter Property="Foreground" Value="#1A1A1A"/>
        <Setter Property="BorderBrush" Value="#8A8A8A"/>
    </Style>

    <Style Selector="Button.play-button-large">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="72"/>
        <Setter Property="Height" Value="72"/>
        <Setter Property="CornerRadius" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.play-button-large /template/ ContentPresenter">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="36"/>
    </Style>
    <Style Selector="Button.play-button-large:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#D8D8D8"/>
    </Style>
    <Style Selector="Button.play-button-large:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#B8B8B8"/>
    </Style>
    <Style Selector="Button.play-button-large:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="#8A8A8A"/>
        <Setter Property="Foreground" Value="#1A1A1A"/>
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.AllowAutoHide" Value="False"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MinHeight" Value="64"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#262626"/>
    </Style>
    <Style Selector="ListBoxItem:focus /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="#2A2A2A"/>
        <Setter Property="Height" Value="8"/>
    </Style>
    <Style Selector="Slider">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="#2A2A2A"/>
    </Style>
    <Style Selector="Slider.volume-slider">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Slider /template/ Thumb">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
    </Style>
    <Style Selector="Slider:horizontal /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Slider:horizontal /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="#2A2A2A"/>
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="#3A3A3A"/>
    </Style>
    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>

    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="#0A0A0A"/>
        <Setter Property="BorderBrush" Value="#2A2A2A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="#0A0A0A"/>
        <Setter Property="BorderBrush" Value="#2A2A2A"/>
        <Setter Property="Foreground" Value="#F2F2F2"/>
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="#F2F2F2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#1A1A1A"/>
    </Style>
</Styles>

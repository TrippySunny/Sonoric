<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sonorics.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <Color x:Key="SystemAccentColor">#FFFFFF</Color>
        <Color x:Key="SystemAccentColorDark1">#E6E6E6</Color>
        <Color x:Key="SystemAccentColorDark2">#C8C8C8</Color>
        <Color x:Key="SystemAccentColorDark3">#A3A3A3</Color>
        <Color x:Key="SystemAccentColorLight1">#F5F5F5</Color>
        <Color x:Key="SystemAccentColorLight2">#FFFFFF</Color>
        <Color x:Key="SystemAccentColorLight3">#FFFFFF</Color>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#000000"/>
        <SolidColorBrush x:Key="AppPanelBrush" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="AppElevatedBrush" Color="#111111"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="AppTextBrush" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="AppMutedBrush" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="AppButtonBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="AppButtonHoverBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="AppSelectedBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="AppHoverBrush" Color="#161616"/>
        <FontFamily x:Key="AppFont">Inter, Segoe UI, Noto Sans, sans-serif</FontFamily>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Sonoric/Styles/Controls.axaml"/>
    </Application.Styles>
</Application>
